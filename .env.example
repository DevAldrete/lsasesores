# ============================================================
# Ejemplo de configuración de entorno
# ============================================================
#
# En Docker (docker-compose.yml) estas variables ya se definen
# automáticamente, por lo que NO necesitas crear el .env.
#
# En XAMPP, copia este archivo como ".env" solo si tus credenciales
# son distintas a las de por defecto. Los valores mostrados abajo ya
# funcionan con una instalación estándar de XAMPP.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=lsasesores
DB_USER=root
DB_PASS=
